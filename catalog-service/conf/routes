# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# ============================================================================
# HEALTH CHECK ENDPOINTS
# ============================================================================
# Dùng cho Consul health check và monitoring
GET     /health                             controllers.HealthController.health()
GET     /health/detailed                    controllers.HealthController.detailedHealth()

# ============================================================================
# CATALOG SERVICE ENDPOINTS
# ============================================================================

# Branch CRUD and lifecycle
GET     /api/v1/catalog/branches                         controllers.BranchController.list()
GET     /api/v1/catalog/branches/:id                     controllers.BranchController.get(id: Long)
POST    /api/v1/catalog/branches                         controllers.BranchController.create(request: Request)
PUT     /api/v1/catalog/branches/:id                     controllers.BranchController.update(id: Long, request: Request)
PATCH   /api/v1/catalog/branches/:id/status              controllers.BranchController.changeStatus(id: Long, request: Request)

# Drug CRUD and search. Keep the barcode route before the numeric-ID route.
GET     /api/v1/catalog/drugs                            controllers.DrugController.search(request: Request)
GET     /api/v1/catalog/drugs/by-barcode/:code           controllers.DrugController.getByBarcode(code: String)
GET     /api/v1/catalog/drugs/:id                        controllers.DrugController.get(id: Long)
POST    /api/v1/catalog/drugs                            controllers.DrugController.create(request: Request)
PUT     /api/v1/catalog/drugs/:id                        controllers.DrugController.update(id: Long, request: Request)
PUT     /api/v1/catalog/drugs/:id/units                   controllers.DrugController.setUnits(id: Long, request: Request)
DELETE  /api/v1/catalog/drugs/:id                        controllers.DrugController.discontinue(id: Long)

# Drug groups
GET     /api/v1/catalog/drug-groups                      controllers.DrugGroupController.list()
GET     /api/v1/catalog/drug-groups/roots                controllers.DrugGroupController.roots()
GET     /api/v1/catalog/drug-groups/:id/children         controllers.DrugGroupController.children(id: Long)
GET     /api/v1/catalog/drug-groups/:id                  controllers.DrugGroupController.get(id: Long)
POST    /api/v1/catalog/drug-groups                      controllers.DrugGroupController.create(request: Request)
PUT     /api/v1/catalog/drug-groups/:id                  controllers.DrugGroupController.update(id: Long, request: Request)
DELETE  /api/v1/catalog/drug-groups/:id                  controllers.DrugGroupController.delete(id: Long)

