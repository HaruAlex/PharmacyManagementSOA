# ============================================================================
# PharmacyManagementSOA — Environment example (Giai đoạn 1)
# Sao chép file này thành .env và điều chỉnh giá trị trước khi chạy.
# KHÔNG commit file .env chứa secret thực tế vào repo.
# ============================================================================

# --- Consul ---
CONSUL_ADDRESS=http://consul:8500
CONSUL_HOST=consul
CONSUL_PORT=8500

# --- JWT (khóa chung cho Auth, Gateway và các service nghiệp vụ) ---
JWT_SECRET=replace-with-a-secret-at-least-32-characters
ISSUER=pharmacy-management-soa
AUDIENCE=pharmacy-management-soa-clients

# --- Application secret (Play) ---
APPLICATION_SECRET=replace-with-a-play-secret-at-least-32-characters

# --- SQL Server (mỗi service một database riêng) ---
SQL_SERVER_HOST=sqlserver
SQL_SERVER_PORT=1433
SA_PASSWORD=replace-with-a-strong-sa-password
DATABASE_USER=sa

# Database per service (được nối vào DATABASE_URL của từng service)
AUTH_DB=auth_db
CATALOG_DB=catalog_db
PURCHASE_DB=purchase_db
INVENTORY_DB=inventory_db
SALES_DB=sales_db

# JDBC URL mẫu (được các service đọc qua DATABASE_URL)
# jdbc:sqlserver://${SQL_SERVER_HOST}:${SQL_SERVER_PORT};databaseName=<DB>;encrypt=false;trustServerCertificate=true

# --- Service listen ports (override cổng runtime) ---
PLAY_HTTP_PORT_GATEWAY=9000
PLAY_HTTP_PORT_AUTH=9001
PLAY_HTTP_PORT_CATALOG=9002
PLAY_HTTP_PORT_INVENTORY=9003
PLAY_HTTP_PORT_PURCHASE=9004
PLAY_HTTP_PORT_SALES=9005

# --- Service registration address (để trống để dùng hostname container) ---
SERVICE_ADDRESS=
SERVICE_HOST=
SERVICE_INSTANCE_ID=
