# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# ============================================================================
# HEALTH CHECK ENDPOINTS
# ============================================================================
GET     /health                             controllers.HealthController.health()
GET     /health/detailed                    controllers.HealthController.detailedHealth()

# ============================================================================
# AUTHENTICATION ENDPOINTS (Phase 2 & 3)
# ============================================================================
+nocsrf
POST    /api/auth/login                     controllers.AuthController.login(request: Request)
+nocsrf
POST    /api/auth/refresh                   controllers.AuthController.refresh(request: Request)
+nocsrf
POST    /api/auth/logout                    controllers.AuthController.logout(request: Request)
+nocsrf
POST    /api/auth/logout-all                controllers.AuthController.logoutAll(request: Request)
GET     /api/auth/validate                  controllers.AuthController.validate(request: Request)
GET     /api/auth/me                        controllers.AuthController.me(request: Request)
+nocsrf
PUT     /api/auth/current-branch            controllers.AuthController.selectBranch(request: Request)

# ============================================================================
# PROFILE ENDPOINTS (Phase 5 - User self-service)
# ============================================================================
GET     /api/auth/profile                   controllers.ProfileController.getProfile(request: Request)
+nocsrf
PUT     /api/auth/profile                   controllers.ProfileController.updateProfile(request: Request)
+nocsrf
PUT     /api/auth/change-password           controllers.ProfileController.changePassword(request: Request)

# ============================================================================
# RBAC ENDPOINTS (Phase 6 - Admin only)
# ============================================================================
# Roles
GET     /api/roles                          controllers.RoleController.list(request: Request)
+nocsrf
POST    /api/roles                          controllers.RoleController.create(request: Request)
GET     /api/roles/:id                      controllers.RoleController.get(id: Integer, request: Request)
+nocsrf
PUT     /api/roles/:id                      controllers.RoleController.update(id: Integer, request: Request)
GET     /api/roles/:id/permissions          controllers.RoleController.getPermissions(id: Integer, request: Request)
+nocsrf
PUT     /api/roles/:id/permissions          controllers.RoleController.updatePermissions(id: Integer, request: Request)

# Permissions
GET     /api/permissions                    controllers.PermissionController.list(request: Request)
+nocsrf
POST    /api/permissions                    controllers.PermissionController.create(request: Request)
GET     /api/permissions/:id                controllers.PermissionController.get(id: Integer, request: Request)
+nocsrf
PUT     /api/permissions/:id                controllers.PermissionController.update(id: Integer, request: Request)

# Audit Logs
GET     /api/audit-logs                     controllers.AuditLogController.search(request: Request)

# ============================================================================
# USER MANAGEMENT ENDPOINTS (Phase 4 - Admin only)
# ============================================================================
+nocsrf
POST    /api/users                          controllers.UserController.create(request: Request)
GET     /api/users                          controllers.UserController.list(request: Request)
GET     /api/users/:id                      controllers.UserController.get(id: Integer, request: Request)
+nocsrf
PUT     /api/users/:id                      controllers.UserController.update(id: Integer, request: Request)
+nocsrf
PUT     /api/users/:id/role-branches        controllers.UserController.updateRoleBranches(id: Integer, request: Request)
+nocsrf
POST    /api/users/:id/lock                 controllers.UserController.lock(id: Integer, request: Request)
+nocsrf
POST    /api/users/:id/unlock               controllers.UserController.unlock(id: Integer, request: Request)
+nocsrf
DELETE  /api/users/:id                      controllers.UserController.delete(id: Integer, request: Request)
+nocsrf
POST    /api/users/:id/activate             controllers.UserController.activate(id: Integer, request: Request)
+nocsrf
POST    /api/users/:id/reset-password       controllers.UserController.resetPassword(id: Integer, request: Request)

# ============================================================================
# STATIC ASSETS
# ============================================================================
GET     /assets/*file                       controllers.Assets.versioned(path="/public", file: Asset)
