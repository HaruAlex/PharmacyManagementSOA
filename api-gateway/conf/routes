# Health and metrics stay local and do not require authentication.
GET     /health                         controllers.MetricsController.health()
GET     /healthz                        controllers.MetricsController.healthz()
GET     /metrics                        controllers.MetricsController.metrics()

# Public service prefixes are mapped in application.conf.
GET     /api                            controllers.GatewayController.proxyRoot(request: play.mvc.Http.Request)
