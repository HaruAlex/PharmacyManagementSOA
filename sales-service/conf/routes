# FR-BH-01: Báo cáo doanh thu, lợi nhuận

# Doanh thu theo ngày - GET /sales/revenue/daily/branch/{branchId}/date/{date}
GET     /revenue/daily/branch/:branchId/date/:date     controllers.SalesRevenueController.getDailyRevenue(request: Request, branchId: Long, date: String)

# Lợi nhuận theo ngày - GET /sales/revenue/daily-profit/branch/{branchId}/date/{date}
GET     /revenue/daily-profit/branch/:branchId/date/:date     controllers.SalesRevenueController.getDailyProfit(request: Request, branchId: Long, date: String)

# Doanh thu theo tuần - GET /sales/revenue/weekly/branch/{branchId}/start-date/{date}
GET     /revenue/weekly/branch/:branchId/start-date/:date     controllers.SalesRevenueController.getWeeklyRevenue(request: Request, branchId: Long, date: String)

# Doanh thu theo tháng - GET /sales/revenue/monthly/branch/{branchId}/year/{year}/month/{month}
GET     /revenue/monthly/branch/:branchId/year/:year/month/:month     controllers.SalesRevenueController.getMonthlyRevenue(request: Request, branchId: Long, year: Int, month: Int)

# Doanh thu trong khoảng ngày - GET /sales/revenue/range/branch/{branchId}/from/{startDate}/to/{endDate}
GET     /revenue/range/branch/:branchId/from/:startDate/to/:endDate     controllers.SalesRevenueController.getRevenueByDateRange(request: Request, branchId: Long, startDate: String, endDate: String)

# Doanh thu theo user & ngày - GET /sales/revenue/user/{userId}/date/{date}
GET     /revenue/user/:userId/date/:date     controllers.SalesRevenueController.getUserRevenue(request: Request, userId: Long, date: String)

# Doanh thu theo shift - GET /sales/revenue/shift/{shiftId}
GET     /revenue/shift/:shiftId     controllers.SalesRevenueController.getShiftRevenue(request: Request, shiftId: Long)

# Margin% doanh thu - GET /sales/revenue/margin/branch/{branchId}/date/{date}
GET     /revenue/margin/branch/:branchId/date/:date     controllers.SalesRevenueController.getRevenueMargin(request: Request, branchId: Long, date: String)

# Top users theo doanh thu - GET /sales/revenue/top-users/branch/{branchId}/date/{date}?limit=10
GET     /revenue/top-users/branch/:branchId/date/:date     controllers.SalesRevenueController.getTopUsersByRevenue(request: Request, branchId: Long, date: String)

# Snapshot báo cáo theo ngày - GET /sales/revenue/snapshot/branch/{branchId}/date/{date}
GET     /revenue/snapshot/branch/:branchId/date/:date     controllers.SalesRevenueController.getDailySnapshot(request: Request, branchId: Long, date: String)

